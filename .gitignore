# WorkBuddy 工具元数据（本地记忆/偏好，不应入库）
.workbuddy/

# 依赖（本地安装）
node_modules/

# 超大词典数据库
data/stardict.db
*.db

# GloVe 词向量（约 332MB，仅聚类时用，超过 GitHub 100MB 限制，不入库）
glove.6B.100d.txt
glove*.txt

# 一次性探索/弃用脚本
scripts/probe_target.py
scripts/remap_cluster_names.py

# 开发中间产物（scripts 批量提取临时文件；保留 .js / .py 等核心脚本）
scripts/*_chunk*.json
scripts/*_examples.json
scripts/batch*.json
scripts/longman*_chunk*.json
scripts/longman*_missing.json

# ===== 以下为“仅上传网页展示所需文件”的补充忽略规则 =====
# 文档（不随网页展示）
README.md
PRD*.md

# 网页展示无关的构建脚本、截图资源与 npm 配置
scripts/
assets/
package.json
package-lock.json

# 构建中间产物 / 分析报告（非运行时所需，网页不加载）
data/cluster_meta.json
data/clusters.json
data/cluster_report.txt
data/longman3000_missing.json
data/longman3000_new_examples.json
data/word_families.json
data/families_review.csv
data/Suffix_Ref_cleaned.csv
data/Suffix_Ref_检查报告.md
